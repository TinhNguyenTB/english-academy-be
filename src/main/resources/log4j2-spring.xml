<?xml version="1.0" encoding="UTF-8" ?>
<Configuration status="WARN">

    <Appenders>
        <!--log ra console-->
        <Console name="Console" target="SYSTEM_OUT">
            <PatternLayout pattern="%d{dd-MM-yyyy HH:mm:ss} [%X{traceId}] [%level] [%c{1}:%L] - %msg%n"></PatternLayout>
        </Console>

        <!--log ra file json-->
        <RollingFile name="JsonFile" fileName="logs/app.json" filePattern="logs/app-%d{dd-MM-yyyy}.json">
            <JsonLayout compact="true" eventEol="true" includeMDC="true" includeAllFields="true" includeStacktrace="true"/>
            <Policies>
                <TimeBasedTriggeringPolicy interval="1"/>
            </Policies>
            <DefaultRolloverStrategy max="30"/>
        </RollingFile>

    </Appenders>

    <Loggers>
        <Root level="info">
            <AppenderRef ref="Console"/>
            <AppenderRef ref="JsonFile"/>
        </Root>
    </Loggers>

</Configuration>